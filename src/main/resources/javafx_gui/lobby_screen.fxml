<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane prefHeight="720.0" prefWidth="470.0" styleClass="dusk-root" stylesheets="@css/theme.css"
           xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox spacing="0.0">
         <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
         </padding>
         <children>
            <Label styleClass="title-lg" text="MESOS" />

            <VBox alignment="CENTER" spacing="14.0" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER" spacing="9.0">
                     <children>
                        <Circle fx:id="lobbyDot1" radius="6.5" fill="#E2592B" />
                        <Circle fx:id="lobbyDot2" radius="6.5" fill="#EAB14A" />
                        <Circle fx:id="lobbyDot3" radius="6.5" fill="#2C8B8C" />
                     </children>
                  </HBox>
                  <Label styleClass="title-lg" text="In attesa degli esploratori" />
                  <Label styleClass="subtitle" text="La partita inizia quando tutti sono pronti">
                     <VBox.margin>
                        <Insets top="-8.0" />
                     </VBox.margin>
                  </Label>
               </children>
            </VBox>

            <VBox spacing="0.0" styleClass="panel-dark">
               <padding>
                  <Insets bottom="14.0" left="18.0" right="18.0" top="14.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label styleClass="field-label" text="GIOCATORI CONNESSI" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="playerCountLabel" styleClass="lobby-count" text="0 / 0" />
                     </children>
                  </HBox>
                  <VBox fx:id="playerListBox" spacing="2.0">
                     <VBox.margin>
                        <Insets top="8.0" />
                     </VBox.margin>
                  </VBox>
               </children>
            </VBox>

            <Button fx:id="leaveButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    onAction="#handleLeave" styleClass="btn-ghost" text="Abbandona">
               <VBox.margin>
                  <Insets top="14.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
</StackPane>
