<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane fx:id="rootPane" prefHeight="800.0" prefWidth="1280.0" styleClass="game-root"
           stylesheets="@css/theme.css, @css/game_screen.css"
           xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Region mouseTransparent="true" styleClass="game-overlay" />
      <VBox>
         <children>

            <!-- ============ HUD ============ -->
            <StackPane styleClass="hud-bar">
               <padding>
                  <Insets bottom="12.0" left="22.0" right="22.0" top="12.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="16.0" StackPane.alignment="CENTER_LEFT">
                     <children>
                        <Label styleClass="title-lg" text="MESOS" />
                        <HBox alignment="CENTER_LEFT" spacing="9.0" styleClass="pill">
                           <children>
                              <Label fx:id="eraLabel" styleClass="era-chip" text="ERA I" />
                              <Separator orientation="VERTICAL" prefHeight="14.0" />
                              <Label fx:id="roundLabel" styleClass="round-chip" text="Round 1 / 10" />
                           </children>
                        </HBox>
                     </children>
                  </HBox>
                  <HBox fx:id="turnPill" alignment="CENTER" spacing="10.0" maxWidth="-Infinity" maxHeight="-Infinity" styleClass="pill-accent" StackPane.alignment="CENTER">
                     <children>
                        <Circle fx:id="turnDot" radius="4.0" fill="#E2592B" />
                        <Label fx:id="yourTurnLabel" styleClass="turn-text" text="In attesa…" />
                     </children>
                  </HBox>
                  <Button mnemonicParsing="false" onAction="#handleShowRules" styleClass="btn-ghost" text="Regole" StackPane.alignment="CENTER_RIGHT" />
               </children>
            </StackPane>

            <!-- ============ PLAYERS STRIP ============ -->
            <HBox fx:id="playersStrip" alignment="CENTER_LEFT" spacing="12.0" styleClass="players-strip">
               <padding>
                  <Insets bottom="11.0" left="22.0" right="22.0" top="11.0" />
               </padding>
            </HBox>

            <!-- ============ MAIN ROW ============ -->
            <HBox VBox.vgrow="ALWAYS">
               <children>

                  <!-- LEFT RAIL: turn order -->
                  <VBox prefWidth="190.0" spacing="12.0" styleClass="left-rail">
                     <padding>
                        <Insets bottom="18.0" left="14.0" right="14.0" top="18.0" />
                     </padding>
                     <children>
                        <Label styleClass="eyebrow" text="ORDINE DI TURNO" />
                        <VBox fx:id="turnOrderList" spacing="8.0" />
                     </children>
                  </VBox>

                  <!-- CENTER: market -->
                  <VBox fx:id="marketBox" spacing="10.0" styleClass="market" HBox.hgrow="ALWAYS">
                     <padding>
                        <Insets bottom="16.0" left="22.0" right="22.0" top="16.0" />
                     </padding>
                     <children>
                        <VBox spacing="7.0" VBox.vgrow="ALWAYS">
                           <children>
                              <Label styleClass="eyebrow" text="FILA SUPERIORE ↑" />
                              <HBox fx:id="topCardsRow" alignment="CENTER_LEFT" spacing="13.0" VBox.vgrow="ALWAYS" />
                           </children>
                        </VBox>
                        <VBox spacing="7.0" VBox.vgrow="ALWAYS">
                           <children>
                              <Label styleClass="eyebrow" text="PISTA DELLE OFFERTE" />
                              <HBox fx:id="middleCardsRow" alignment="CENTER_LEFT" spacing="13.0" VBox.vgrow="ALWAYS" />
                           </children>
                        </VBox>
                        <VBox spacing="7.0" VBox.vgrow="ALWAYS">
                           <children>
                              <Label styleClass="eyebrow" text="FILA INFERIORE ↓" />
                              <HBox fx:id="bottomCardsRow" alignment="CENTER_LEFT" spacing="13.0" VBox.vgrow="ALWAYS" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- RIGHT RAIL: tribe (parchment) -->
                  <VBox prefWidth="272.0" styleClass="right-rail">
                     <padding>
                        <Insets bottom="16.0" left="0.0" right="16.0" top="16.0" />
                     </padding>
                     <children>
                        <VBox spacing="13.0" styleClass="parchment" VBox.vgrow="ALWAYS">
                           <padding>
                              <Insets bottom="17.0" left="17.0" right="17.0" top="17.0" />
                           </padding>
                           <children>
                              <Label styleClass="parchment-title" text="La mia tribù" />
                              <HBox spacing="10.0">
                                 <children>
                                    <VBox spacing="2.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                       <padding>
                                          <Insets bottom="11.0" left="13.0" right="13.0" top="11.0" />
                                       </padding>
                                       <children>
                                          <Label styleClass="stat-cap" text="CIBO" />
                                          <Label fx:id="foodLabel" styleClass="stat-food" text="0" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="2.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                       <padding>
                                          <Insets bottom="11.0" left="13.0" right="13.0" top="11.0" />
                                       </padding>
                                       <children>
                                          <Label styleClass="stat-cap" text="PRESTIGIO" />
                                          <Label fx:id="prestigeLabel" styleClass="stat-prestige" text="0" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>

                              <Label styleClass="stat-cap" text="PERSONAGGI &amp; EDIFICI">
                                 <VBox.margin>
                                    <Insets top="2.0" />
                                 </VBox.margin>
                              </Label>

                              <VBox spacing="7.0">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="9.0">
                                       <children>
                                          <Circle radius="5.5" fill="#2C8B8C" />
                                          <Label styleClass="tribe-row" text="Artisti" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" />
                                          <Label fx:id="artistNumberLabel" styleClass="tribe-count" text="0" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="9.0">
                                       <children>
                                          <Circle radius="5.5" fill="#B5793A" />
                                          <Label styleClass="tribe-row" text="Costruttori" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" />
                                          <Label fx:id="constructorNumberLabel" styleClass="tribe-count" text="0" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="9.0">
                                       <children>
                                          <Circle radius="5.5" fill="#7A3B5E" />
                                          <Label styleClass="tribe-row" text="Sciamani" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" />
                                          <Label fx:id="shamanNumberLabel" styleClass="tribe-count" text="0" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="9.0">
                                       <children>
                                          <Circle radius="5.5" fill="#E0432B" />
                                          <Label styleClass="tribe-row" text="Cacciatori" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" />
                                          <Label fx:id="hunterNumberLabel" styleClass="tribe-count" text="0" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="9.0">
                                       <children>
                                          <Circle radius="5.5" fill="#4E7A3C" />
                                          <Label styleClass="tribe-row" text="Raccoglitori" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" />
                                          <Label fx:id="collectorNumberLabel" styleClass="tribe-count" text="0" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="9.0">
                                       <children>
                                          <Circle radius="5.5" fill="#3B6FD4" />
                                          <Label styleClass="tribe-row" text="Inventori" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" />
                                          <Label fx:id="inventorNumberLabel" styleClass="tribe-count" text="0" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="9.0" styleClass="tribe-divider">
                                       <padding>
                                          <Insets top="7.0" />
                                       </padding>
                                       <children>
                                          <Circle radius="5.5" fill="#EAB14A" />
                                          <Label styleClass="tribe-row" text="Edifici" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" />
                                          <Label fx:id="buildingNumberLabel" styleClass="tribe-count" text="0" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>

                              <Region VBox.vgrow="ALWAYS" />
                              <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                                      onAction="#handleShowTribePopupDirectly" styleClass="btn-dark"
                                      text="Vedi tutta la tribù" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

               </children>
            </HBox>

            <!-- ============ ACTION BAR ============ -->
            <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="action-bar">
               <padding>
                  <Insets bottom="16.0" left="22.0" right="22.0" top="16.0" />
               </padding>
               <children>
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="eyebrow" text="LA TUA PESCATA" />
                        <Label fx:id="quotaLabel" styleClass="quota-text" text="In attesa del tuo turno" />
                     </children>
                  </VBox>
               </children>
            </HBox>

         </children>
      </VBox>
   </children>
</StackPane>
